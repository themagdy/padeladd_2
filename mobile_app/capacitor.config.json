{
  "appId": "com.padeladd.app",
  "appName": "Padeladd",
  "webDir": "www",
  "bundledWebRuntime": false,
  "plugins": {
    "StatusBar": {
      "backgroundColor": "#171C26",
      "style": "DARK"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"],
      "iconColor": "#171C26"
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "statsUrl": "",
      "updateUrl": "https://padeladd.com/backend/api/app/check_update.php",
      "header": {
        "X-App-Update-Token": "pdl_sec_ota_8f92a471b0c9e"
      }
    }
  },
  "ios": {
    "allowsLinkPreview": false,
    "handleApplicationNotifications": true,
    "scrollEnabled": true,
    "allowsBackForwardNavigationGestures": true
  }
}
