<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # ----------------------------------------------------------------------
    # Pass Authorization headers to PHP
    # ----------------------------------------------------------------------
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    CGIPassAuth On

    # ----------------------------------------------------------------------
    # Security Headers
    # ----------------------------------------------------------------------
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"

    # Serve Apple App Site Association as application/json
    <Files "apple-app-site-association">
        Header set Content-Type "application/json"
    </Files>

    # Route /share/MATCH-CODE to the social share PHP page
    RewriteRule ^share/([A-Za-z0-9\-]+)$ share/match.php?code=$1 [QSA,L]

    # Redirect root domain to /app/ on LIVE SERVER ONLY (padeladd.com)
    # Leaves localhost / 127.0.0.1 100% untouched
    RewriteCond %{HTTP_HOST} ^(www\.)?padeladd\.com$ [NC]
    RewriteCond %{REQUEST_URI} ^/+$ [OR]
    RewriteCond %{REQUEST_URI} ^/index\.html$
    RewriteRule ^ https://padeladd.com/app/ [R=301,L]

    # Handle SPA routing - relative to wherever .htaccess is placed
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Exclude the backend/api directory from frontend routing (wildcard match)
    RewriteCond %{REQUEST_URI} !/backend/api/
    # Exclude the share directory from SPA routing
    RewriteCond %{REQUEST_URI} !/share/
    # Exclude well-known domain association metadata directories
    RewriteCond %{REQUEST_URI} !/\.well-known/
    RewriteRule ^ index.html [QSA,L]
</IfModule>
