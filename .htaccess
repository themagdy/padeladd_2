<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Disable directory browsing site-wide and redirect 403/404 errors to homepage
    Options -Indexes
    ErrorDocument 403 https://padeladd.com/
    ErrorDocument 404 https://padeladd.com/
    
    # ----------------------------------------------------------------------
    # Pass Authorization headers to PHP
    # ----------------------------------------------------------------------
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    CGIPassAuth On

    # ----------------------------------------------------------------------
    # Security Headers
    # ----------------------------------------------------------------------
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"

    # Serve Apple App Site Association as application/json
    <Files "apple-app-site-association">
        Header set Content-Type "application/json"
    </Files>

    # Redirect /reset-password on live website (padeladd.com) to /app/reset_pass
    RewriteCond %{HTTP_HOST} ^(www\.)?padeladd\.com$ [NC]
    RewriteRule ^reset-password /app/reset_pass [R=302,L]

    # Redirect /verify-email and /verify_email on live website (padeladd.com) to /app/verify_email
    RewriteCond %{HTTP_HOST} ^(www\.)?padeladd\.com$ [NC]
    RewriteRule ^(verify-email|verify_email) /app/verify_email/ [QSA,R=302,L]

    # Route /share/MATCH-CODE to the social share PHP page
    RewriteRule ^share/([A-Za-z0-9\-]+)$ share/match.php?code=$1 [QSA,L]

    # Handle SPA routing - relative to wherever .htaccess is placed
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Exclude the backend/api directory from frontend routing (wildcard match)
    RewriteCond %{REQUEST_URI} !/backend/api/
    # Exclude the share directory from SPA routing
    RewriteCond %{REQUEST_URI} !/share/
    # Exclude well-known domain association metadata directories
    RewriteCond %{REQUEST_URI} !/\.well-known/
    RewriteRule ^ index.html [QSA,L]
</IfModule>
